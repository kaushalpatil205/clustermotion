# Names must match the Pod Identity associations in infra/terraform/cluster/pod_identity.tf
{{- range $sa := list "orders" "order-sweeper" "fulfillment-worker" "lease-agent" }}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ $sa }}
  labels:
    {{- include "shop.labels" $ | nindent 4 }}
---
{{- end }}
